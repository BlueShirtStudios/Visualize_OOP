<Window x:Class="VisualizeOOP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VisualizeOOP"
        xmlns:wf="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Navigation Controls -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="txtFolderPath" Width="400" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
            <Button Content="Analyze &amp; Build Graph" Click="BtnAnalyze_Click" Padding="10,5"/>
            <!-- Segmented toggle (RadioButtons styled as buttons) -->
            <RadioButton x:Name="rbSummary" Content="Summary" IsChecked="True"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Padding="14,4" Checked="Mode_Checked"/>
            <RadioButton x:Name="rbDetailed" Content="Detailed"
                             Style="{StaticResource {x:Type ToggleButton}}"
                             Padding="14,4" Checked="Mode_Checked"/>
        </StackPanel>

        <!-- Sidebar & Graph Display area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar Class Selection -->
            <Border Grid.Column="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,1,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Discovered Classes" 
                               Foreground="White" FontWeight="Bold" Margin="10"/>

                    <ListBox x:Name="lstClasses" 
                             ItemsSource="{Binding Classes}" 
                             DisplayMemberPath="Name"
                             SelectionChanged="LstClasses_SelectionChanged"
                             Background="#1E1E1E" 
                             Foreground="#DCDCDC" 
                             BorderThickness="0"/>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#3F3F46"/>

            <!-- MSAGL Graph Viewer Host -->
            <Border Grid.Column="2" Background="#1E1E1E">
                <wf:WindowsFormsHost x:Name="wfHost" />
            </Border>
        </Grid>
    </Grid>
</Window>
